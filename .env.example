# SentinelForge Environment Configuration
# Copy this to .env and fill in values.
#
# Every variable is namespaced with SENTINELFORGE_. The prefix is required: it
# stops generic names such as DEBUG or HOST from being inherited accidentally
# from the shell or a container runtime.

# Database
SENTINELFORGE_DATABASE_URL=sqlite+aiosqlite:///./sentinelforge.db

# IBM watsonx.ai Configuration
SENTINELFORGE_IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
SENTINELFORGE_IBM_WATSONX_API_KEY=
SENTINELFORGE_IBM_WATSONX_PROJECT_ID=
SENTINELFORGE_IBM_MODEL_ID=ibm/granite-3-8b-instruct

# AI Provider Selection: mock | ibm_watsonx
SENTINELFORGE_AI_PROVIDER=mock

# Docker Configuration
SENTINELFORGE_DOCKER_HOST=unix:///var/run/docker.sock
SENTINELFORGE_SANDBOX_TIMEOUT=300
SENTINELFORGE_SANDBOX_MEMORY_LIMIT=512m
SENTINELFORGE_SANDBOX_CPU_LIMIT=1.0

# Application
SENTINELFORGE_APP_HOST=0.0.0.0
SENTINELFORGE_APP_PORT=8000
SENTINELFORGE_DEBUG=true
SENTINELFORGE_LOG_LEVEL=INFO

# Frontend
SENTINELFORGE_NEXT_PUBLIC_API_URL=http://localhost:8000

# Security
SENTINELFORGE_SECRET_KEY=change-me-in-production
SENTINELFORGE_MAX_UPLOAD_SIZE=104857600

# Runtime state
# DATA_DIRNAME is the single knob for all mutable state: the SQLite file,
# staged uploads and extracted (untrusted) repositories all live beneath it.
# Relative UPLOAD_DIR / WORKSPACE_DIR values resolve inside DATA_DIRNAME;
# absolute values are used as given.
SENTINELFORGE_DATA_DIRNAME=./data
SENTINELFORGE_UPLOAD_DIR=uploads
SENTINELFORGE_WORKSPACE_DIR=workspaces

# Sandbox
# "docker" is the only secure backend and the one to use in production.
# "local" runs target code as a subprocess on the host: development only.
SENTINELFORGE_SANDBOX_BACKEND=local
SENTINELFORGE_SANDBOX_ALLOW_LOCAL_FALLBACK=true
